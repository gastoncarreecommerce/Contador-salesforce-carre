{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["fonts/**"]
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/countdown", "dest": "/api/countdown.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
